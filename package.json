{
  "name": "chmodxrun",
  "displayName": "Chmod X Run",
  "description": "Right-click any .sh or .bash file to make it executable and run it in the terminal — no more manual chmod +x.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "publisher": "HazyIo",
  "keywords": [
    "shell",
    "bash",
    "sh",
    "chmod",
    "executable",
    "run script",
    "terminal",
    "shell script",
    "context menu",
    "unix"
  ],
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hazyio/chmodxrun"
  },
  "icon": "media/icon.png",
  "license": "MIT",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chmodxrun.run",
        "title": "Chmod X Run: Run"
      },
      {
        "command": "chmodxrun.runSilent",
        "title": "Chmod X Run: Run Silently"
      },
      {
        "command": "chmodxrun.markExecutable",
        "title": "Chmod X Run: Mark Executable"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "chmodxrun.markExecutable",
          "when": "false"
        },
        {
          "command": "chmodxrun.run",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "chmodxrun.run",
          "when": "resourceExtname == .sh || resourceExtname == .bash",
          "group": "1_chmodxrun@1"
        },
        {
          "command": "chmodxrun.runSilent",
          "when": "resourceExtname == .sh || resourceExtname == .bash",
          "group": "1_chmodxrun@2"
        },
        {
          "command": "chmodxrun.markExecutable",
          "when": "resourceExtname == .sh || resourceExtname == .bash",
          "group": "1_chmodxrun@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
